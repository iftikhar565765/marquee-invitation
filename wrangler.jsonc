{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marquee-invitation",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marquee-invitations",
      "database_id": "29cc2d23-99fc-46fd-b5dc-a32898c50585"
    }
  ]
}
